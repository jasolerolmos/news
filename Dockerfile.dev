# Dockerfile para desarrollo (más simple y rápido)
FROM node:20-bookworm-slim

WORKDIR /app

# Chromium headless para la captura de HTML de El Pais.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    ELPAIS_PYTHON=/opt/elpais-venv/bin/python
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && python3 -m venv /opt/elpais-venv \
    && /opt/elpais-venv/bin/pip install --no-cache-dir playwright==1.52.0 beautifulsoup4==4.13.4 \
    && /opt/elpais-venv/bin/python -m playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# Copiar package files
COPY package.json package-lock.json* ./

# El lockfile puede omitir el SWC de la plataforma. Instalar y comprobar el
# binario glibc correspondiente sin modificar el lockfile del repositorio.
RUN npm install \
    && node -e "const {execFileSync}=require('node:child_process'); const arch=process.arch; if(!['arm64','x64'].includes(arch)) throw Error('Arquitectura SWC no soportada: '+arch); const name='@next/swc-linux-'+arch+'-gnu'; const version=require('next/package.json').optionalDependencies[name]; if(!version) throw Error('Next no declara '+name); execFileSync('npm',['install','--no-save','--package-lock=false',name+'@'+version],{stdio:'inherit'}); require(name);"

# Copiar el resto del código
COPY . .

# Exponer puerto
EXPOSE 3000

# Comando para desarrollo con hot-reload
CMD ["npm", "run", "dev"]
